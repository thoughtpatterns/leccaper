#!/usr/bin/env -S dash -eu

readonly root="${0%/*}"

die() { error "$@" ; exit 1 ; }

error()
{
	if [ "$#" -eq 1 ]
	then printf 'fatal: %s\n' "$1" >&2
	else printf "fatal: $@" >&2
	fi
}

usage() { printf '%s\n' 'usage: vff INPUT OUTPUT [<vf options>]'; }

readonly input="$1" ; readonly output="$2" ; shift 2

for video in "$input/"*.mp4
do
	base="$output/${video##*/}" ; stem="${base%.mp4}"
	vf "$@" "$video" "$stem" ; fdupes "$stem"
done
