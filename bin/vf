#!/usr/bin/env -S dash -eu

# See <https://ffmpeg.org/ffmpeg-filters.html#mpdecimate> for details on 'mpdecimate'. The idea is, a frame may be
# dropped if,
#   (1) no 8x8 pixel block has a difference ≥ 'hi', and
#   (2) fewer than a fraction, 'frac', of blocks, have a difference ≥ 'lo'.
# Note; I believe that _difference_, here, is simply (r_1 + g_1 + b_1) - (r_2 + g_2 + b_2).
#
# The default parameters were tested via refinement on a handful of lectures, to minimize duplication of slides due to
# laser pointer movement, and to reduce false positives (i.e., to avoid wrongful rejections). Consider the below cases:
#   (*) If slide transitions are batched (i.e., equations or arrows appear together), we want to _raise_ the number of
#       blocks to change, to _keep_ a frame; so, reduce 'frac'.
#   (*) If _many_ laser duplicates appear (in my experience, two or three for a ninety-minute lecture were unavoidable),
#       then raise 'frac'.
# Tuning 'lo' may offer finer control; e.g., if the laser pointer in your lecture videos looks different to the one
# which appears in mine :-). 'hi' is set to prevent the laser pointer from "forcing" a duplicate, via rule (1); it
# probably shouldn't be tuned.

check()
{
	if [ "$1" -lt 2 ]
	then usage ; exit 1
	fi
}

die() { error "$@" ; exit 1 ; }

error()
{
	if [ "$#" -eq 1 ]
	then printf 'fatal: %s\n' "$1" >&2
	else printf "fatal: $@" >&2
	fi
}

usage()
{
	# This used to be `>&2 cat <<- EOF ...`, but that would miraculously _not_ work _if_ the heredoc had at least
	# five lines. It seems to be a relatively obscure `dash` bug :-) (or I've missed something obvious, which is
	# more likely).
	printf %s "
		usage: vf [<OPTIONS>] INPUT OUTPUT
		options:
		  -i HI,     --hi HI        mpdecimate parameter; see documentation at top of script  default := '10000'
		  -l LO,     --lo LO        mpdecimate parameter; ...                                 default := '3000'
		  -f FRAC,   --frac FRAC    mpdecimate parameter; ...                                 default := '0.01'
		  -w WIDTH,  --width WIDTH  crop width; assumes full height, from left of input       default := 'iw/2'
		  -h,        --help         show this help message and exit
	" | tail '-c+2' | sed -Ee 's/^\t+//g' >&2
}

while [ "$#" -gt 0 ] && [ "${1-}" != "${1#-}" ]
do
	case "$1" in
	('-i'|'--hi')    check "$#" ; readonly hi="$2"    ; shift ;;
	('-l'|'--lo')    check "$#" ; readonly lo="$2"    ; shift ;;
	('-f'|'--frac')  check "$#" ; readonly frac="$2"  ; shift ;;
	('-w'|'--width') check "$#" ; readonly width="$2" ; shift ;;
	('-h'|'--help') usage 2>&1 ; exit 0 ;;
	(*) error "unrecognized switch '$1'" ; usage ; exit 1 ;;
	esac

	shift
done

if [ "$#" -ne 2 ]
then usage ; exit 1
fi

readonly input="$1" output="$2"
readonly vf="crop=${width-iw/2}:ih:0:0,fps=1,hqdn3d=0:0:6:6,mpdecimate=hi=${hi-10000}:lo=${lo-3000}:frac=${frac-0.01}"

mkdir -p "$output" ; ffmpeg -loglevel 'error' -stats -i "$input" -fps_mode 'passthrough' -vf "$vf" "$output/%d.png"
