#!/usr/bin/env -S dash -eu

readonly root="${0%/*}"

# preset0() { readonly hi='32' ; readonly lo='160' ; readonly frac='0.0001' ; }
# preset1() { readonly hi='64' ; readonly lo='320' ; readonly frac='0.0010' ; }
# preset2() { readonly hi='64' ; readonly lo='600' ; readonly frac='0.0050' ; }
# preset3() { readonly hi='80' ; readonly lo='800' ; readonly frac='0.0500' ; }

preset0() { readonly hi='800' ; readonly lo='2400' ; readonly frac='0.0005' ; }
preset1() { readonly hi='800' ; readonly lo='2400' ; readonly frac='0.0020' ; }
preset2() { readonly hi='800' ; readonly lo='2400' ; readonly frac='0.0050' ; }
preset3() { readonly hi='800' ; readonly lo='2400' ; readonly frac='0.0100' ; }

die() { error "$@" ; exit 1 ; }

error()
{
	if [ "$#" -eq 1 ]
	then printf 'fatal: %s\n' "$1" >&2
	else printf "fatal: $@" >&2
	fi
}

ff() { ffmpeg -hide_banner -loglevel 'error' -stats -i "$1" -fps_mode 'passthrough' -vf "$2" "$3" ; }

usage()
{
	cat <<- EOF
		usage: vf [<options>] INPUT OUTPUT
		options:
		  -d DELTA,  --delta DELTA   frame threshold, ∈ [0,1]                                 default := '0.0005'
		  -p PRESET, --preset PRESET clone prune preset, ∈ ℤ ∩ [0,3]; preset number ∝ prunes  default := '1'
		  -w WIDTH,  --width WIDTH   crop width; assumes full height, from left of input      default := 'iw/2'
		  -D PATH,   --debug PATH    save rejected frames to PATH, to test false negatives
		  -h,        --help          print this message and exit
	EOF
}

while [ "$#" -gt 0 ] && [ "${1-}" != "${1#-}" ]
do
	case "$1" in
	('-d'|'--delta')
		if [ "$#" -lt 2 ]
		then usage ; exit 1
		fi

		readonly delta="$2" ; shift ;;
	('-p'|'--preset')
		if [ "$#" -lt 2 ]
		then usage ; exit 1
		fi

		case "$2" in
		([0-3]) eval "preset$2" ;;
		(*) error "unrecognized preset '$2'" ; usage ; exit 1 ;;
		esac

		shift ;;
	('-w'|'--width')
		if [ "$#" -lt 2 ]
		then usage ; exit 1
		fi

		readonly width="crop=$2:ih:0:0" ; shift ;;
	('-D'|'--debug')
		if [ "$#" -lt 2 ]
		then usage ; exit 1
		fi

		readonly debug="$2" ; shift ;;
	('-h'|'--help') usage ; exit 0 ;;
	(*) error "unrecognized switch '$1'" ; usage ; exit 1 ;;
	esac

	shift
done

if [ "$#" -ne 2 ]
then usage ; exit 1
fi

if [ -z "${hi-}" ]
then preset1
fi

readonly input="$1" ; readonly output="$2"

readonly vf0="${width-'crop=iw/2:ih:0:0'},fps=1,hqdn3d=0:0:6:6"
readonly vf3="mpdecimate=hi=$hi:lo=$lo:frac=$frac"

mkdir -p "$output" ; ff "$input" "$vf0,$vf3" "$output/%d.png"

if [ -n "${debug-}" ]
then mkdir -p "$debug" ; ff "$input" "$vf0,$vf3" "$debug/%d.png"
fi
